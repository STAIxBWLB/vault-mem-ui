{
  "name": "@staix/vault-mem-ui",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "vmem-ui": "bin/vmem-ui.ts"
  },
  "exports": {
    ".": "./src/plugin/index.ts",
    "./ui-plugin": "./src/plugin/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "bin/",
    "dist/panel.js",
    "dist/panel.css",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/client/panel.tsx --outdir dist --target browser --format esm --minify --define 'process.env.NODE_ENV=\"production\"' --metafile=dist/metafile.json && cp src/client/panel.css dist/panel.css && bun run scripts/check-notices.ts",
    "check": "bun run build && bun run typecheck && bun run test",
    "release:tag": "bun scripts/release-tag.ts"
  },
  "dependencies": {
    "@staix/vault-mem": "0.12.1",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@staix/agent-console": "github:STAIxBWLB/agent-console#8babe31f421682670a17ee2498f485e6f9ea20a5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
